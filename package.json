{
  "name": "nodo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/dashboard.e2e.cjs && node e2e/auth.e2e.cjs",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^9.1.2",
    "@capacitor/core": "^7.6.11",
    "@capacitor/share": "^7.0.4",
    "@heroui/react": "^3.2.8",
    "@heroui/styles": "^3.2.8",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "capacitor-secure-storage-plugin": "^0.12.0",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.11",
    "@capacitor/cli": "^7.6.11",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
